// Release 1 starting schema. Changes need lead review.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum CompanyType {
  SHIPPER
  CARRIER
}

enum TripStatus {
  REQUEST_RECEIVED
  BOOKED
  QUOTES_REQUESTED
  QUOTES_RECEIVED
  AWARDED
  SOURCING_TRUCK
  TRUCK_CONFIRMED
  CLEARED
  READY_FOR_PICKUP
  IN_TRANSIT
  DELIVERED
  POD_RECEIVED
  INVOICED
  CLOSED
  ON_HOLD
  CANCELLED
}

enum ApprovalStatus {
  PENDING
  APPROVED
  CHANGED
  REJECTED
}

model Company {
  id        String      @id @default(cuid())
  name      String
  type      CompanyType
  users     User[]
  createdAt DateTime    @default(now())
}

model User {
  id        String   @id @default(cuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id])
  name      String
  email     String?  @unique
  phone     String?  @unique
  role      String
  language  String   @default("en")
  channel   String   @default("whatsapp")
  passwordHash String?
  isActive  Boolean  @default(true)
  sessions  Session[]
  createdAt DateTime @default(now())
}

// Web login session (bearer token). Expired or logged-out sessions are deleted.
model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model Lane {
  id        String @id @default(cuid())
  shipperId String
  origin    String
  destination String
  truckType String
}

model Truck {
  id          String    @id @default(cuid())
  carrierId   String
  number      String    @unique
  truckType   String
  rcExpiry    DateTime?
  insuranceExpiry DateTime?
  permitExpiry DateTime?
  fitnessExpiry DateTime?
}

model Driver {
  id            String    @id @default(cuid())
  carrierId     String
  name          String
  phone         String    @unique
  licenceNumber String?
  licenceExpiry DateTime?
}

model RateCard {
  id        String  @id @default(cuid())
  carrierId String
  shipperId String?
  laneId    String
  truckType String
  rate      Decimal @db.Decimal(12, 2)
  bandPct   Decimal @db.Decimal(5, 2)
}

model LrSeries {
  id        String @id @default(cuid())
  carrierId String @unique
  prefix    String
  nextNumber Int   @default(1)
}

model Trip {
  id         String     @id @default(cuid())
  shipperId  String
  carrierId  String?
  laneId     String?
  pickupDate DateTime?
  material   String?
  weightKg   Decimal?   @db.Decimal(12, 2)
  truckType  String?
  truckId    String?
  driverId   String?
  status     TripStatus @default(REQUEST_RECEIVED)
  quotes     Quote[]
  documents  Document[]
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
}

model Quote {
  id        String   @id @default(cuid())
  tripId    String
  trip      Trip     @relation(fields: [tripId], references: [id])
  carrierId String
  amount    Decimal  @db.Decimal(12, 2)
  score     Decimal? @db.Decimal(6, 2)
  isWinner  Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Document {
  id        String   @id @default(cuid())
  tripId    String
  trip      Trip     @relation(fields: [tripId], references: [id])
  kind      String   // LR, EWAY_BILL, POD, INVOICE
  number    String?
  isVoid    Boolean  @default(false)
  fileUrl   String?
  createdAt DateTime @default(now())
}

model Approval {
  id          String         @id @default(cuid())
  tripId      String?
  kind        String         // AWARD, QUOTE, INVOICE, OVERRIDE, ...
  approverId  String?
  status      ApprovalStatus @default(PENDING)
  payload     Json
  reason      String?
  decidedAt   DateTime?
  createdAt   DateTime       @default(now())
}

model MessageLog {
  id        String   @id @default(cuid())
  tripId    String?
  personId  String?
  direction String
  channel   String
  body      Json
  createdAt DateTime @default(now())
}

model AuditLog {
  id        String   @id @default(cuid())
  tripId    String?
  actor     String   // agent name or user id
  action    String
  reason    String?
  data      Json?
  createdAt DateTime @default(now())
}
