// Release 1 starting schema. Changes need lead review.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum CompanyType {
  SHIPPER
  CARRIER
}

enum TripStatus {
  REQUEST_RECEIVED
  BOOKED
  QUOTES_REQUESTED
  QUOTES_RECEIVED
  AWARDED
  SOURCING_TRUCK
  TRUCK_CONFIRMED
  CLEARED
  READY_FOR_PICKUP
  IN_TRANSIT
  DELIVERED
  POD_RECEIVED
  INVOICED
  CLOSED
  ON_HOLD
  CANCELLED
}

enum ApprovalStatus {
  PENDING
  APPROVED
  CHANGED
  REJECTED
}

model Company {
  id        String      @id @default(cuid())
  name      String
  type      CompanyType
  // Carrier added by a shipper but not yet on DigitRell: INVITED. Otherwise ACTIVE.
  status    String      @default("ACTIVE")
  phone     String?
  // Carrier profile (carrier spec C3). PAN and GSTIN are checked for format; verification needs a provider.
  gstin           String?
  pan             String?
  address         String?
  // FCM = carrier charges GST; RCM = shipper pays under reverse charge.
  gstOption       String?
  // Owns 10 or fewer goods carriages, so shippers don't deduct TDS (section 194C).
  tdsDeclared     Boolean   @default(false)
  tdsDeclaredAt   DateTime?
  bankAccountName String?
  bankAccountNo   String?
  bankIfsc        String?
  users     User[]
  addresses Address[]
  lanes     Lane[]      @relation("ShipperLanes")
  carrierOn LaneCarrier[]
  policy    ShipperPolicy?
  carrierPolicy CarrierPolicy?
  invoiceSeries CarrierInvoiceSeries?
  trips     Trip[]      @relation("ShipperTrips")
  wonTrips  Trip[]      @relation("CarrierTrips")
  quotes    Quote[]
  performance CarrierPerformance?
  // Carrier master: carriers a shipper works with (as shipper), and shippers listing a carrier (as carrier).
  carriersListed ShipperCarrier[] @relation("ShipperCarriers")
  listedBy       ShipperCarrier[] @relation("CarrierShippers")
  rateCardsHeld  RateCard[]       @relation("ShipperRateCards")
  rateCardsGiven RateCard[]       @relation("CarrierRateCards")
  createdAt DateTime    @default(now())
}

// A shipper's record of one carrier it works with (carrier master). The carrier company itself is
// shared across shippers; contact details and notes here belong to this shipper only.
model ShipperCarrier {
  shipperId    String
  shipper      Company  @relation("ShipperCarriers", fields: [shipperId], references: [id])
  carrierId    String
  carrier      Company  @relation("CarrierShippers", fields: [carrierId], references: [id])
  contactName  String?
  contactPhone String?
  email        String?
  city         String?
  address      String?
  gstin        String?
  pan          String?
  notes        String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@id([shipperId, carrierId])
  @@index([carrierId])
}

// A carrier's track record. Owned by the carrier/tracking modules; seeded until they exist.
model CarrierPerformance {
  carrierId  String   @id
  carrier    Company  @relation(fields: [carrierId], references: [id])
  trips      Int      @default(0)
  onTimePct  Int      // 0–100
  podDays    Decimal  @db.Decimal(4, 1) // average days from delivery to POD
  acceptPct  Int      // share of awarded loads the carrier actually took
  updatedAt  DateTime @updatedAt
}

// A saved pickup or drop location of a shipper.
model Address {
  id           String   @id @default(cuid())
  companyId    String
  company      Company  @relation(fields: [companyId], references: [id])
  name         String
  city         String
  line1        String
  kind         String   // PICKUP | DROP | BOTH
  contactName  String?
  contactPhone String?
  hours        String?
  isActive     Boolean  @default(true)
  pickups      Trip[]   @relation("TripPickup")
  drops        Trip[]   @relation("TripDrop")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([companyId, name])
}

// Carriers a shipper approves for one lane. Quote requests go only to these (BRD §4.2).
model LaneCarrier {
  laneId    String
  lane      Lane     @relation(fields: [laneId], references: [id], onDelete: Cascade)
  carrierId String
  carrier   Company  @relation(fields: [carrierId], references: [id])
  createdAt DateTime @default(now())

  @@id([laneId, carrierId])
}

// One row per shipper company: limits and agent autonomy (BRD §6).
model ShipperPolicy {
  companyId            String   @id
  company              Company  @relation(fields: [companyId], references: [id])
  paymentApprovalAbove Decimal  @default(50000) @db.Decimal(12, 2)
  quoteWindowHours     Int      @default(2)
  podRule              String   @default("DIGITAL") // DIGITAL | HARD_COPY | BOTH
  autonomy             Json     // { tender, bidEvaluation, billing }: 0 suggest, 1 ask first, 2 act within limits
  updatedById          String?
  updatedAt            DateTime @updatedAt
}

// One row per carrier company: quote band, margin floor, limits and agent autonomy (carrier spec C3).
model CarrierPolicy {
  companyId            String   @id
  company              Company  @relation(fields: [companyId], references: [id])
  // Quotes within ±bandPct of the rate card can go out without the owner.
  bandPct              Decimal  @default(5) @db.Decimal(5, 2)
  // No quote is sent below this margin (uses a trip cost per rate-card line from phase 2).
  marginFloorPct       Decimal  @default(8) @db.Decimal(5, 2)
  // Invoices to shippers above this amount need the owner's approval.
  invoiceApprovalAbove Decimal  @default(25000) @db.Decimal(12, 2)
  // Gets reminders when the owner hasn't answered an approval in time.
  backupApproverId     String?
  autonomy             Json     // { quote, truckAssignment, documents, billing }: 0 suggest, 1 ask first, 2 act within limits
  updatedById          String?
  updatedAt            DateTime @updatedAt
}

// A carrier's own invoice numbering (carrier phase 6): PREFIX/FY/0001, one running count, a number is never reused.
model CarrierInvoiceSeries {
  companyId  String   @id
  company    Company  @relation(fields: [companyId], references: [id])
  prefix     String
  nextNumber Int      @default(1)
  updatedAt  DateTime @updatedAt
}

// A photo or PDF of a paper (carrier phase 7: truck RC, insurance, permit, fitness, PUC). The row with
// replacedAt null is the live one per owner + docKey. extractStatus/extractedJson are for the future AI reader.
model FileUpload {
  id            String    @id @default(cuid())
  companyId     String
  // TRUCK for now.
  ownerType     String
  ownerId       String
  // rcExpiry | insuranceExpiry | permitExpiry | fitnessExpiry | pucExpiry
  docKey        String
  fileName      String
  mimeType      String
  size          Int
  storageKey    String
  uploadedById  String
  createdAt     DateTime  @default(now())
  // NONE | PENDING | DONE | FAILED
  extractStatus String    @default("NONE")
  extractedJson Json?
  replacedAt    DateTime?

  @@index([ownerType, ownerId, docKey])
  @@index([companyId])
}

model User {
  id        String   @id @default(cuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id])
  name      String
  email     String?  @unique
  phone     String?  @unique
  role      String
  // Carrier users may hold several roles (one person is often owner and traffic manager). `role` is
  // the main one shown in the header; access checks use `role` plus `roles`.
  roles     String[] @default([])
  language  String   @default("en")
  // Email update preferences: which updates, and quiet hours "22:00-07:00" or null.
  // Stored for the notifications module; nothing sends messages yet.
  notifyPrefs Json?
  quietHours  String?
  passwordHash String?
  isActive  Boolean  @default(true)
  // Largest single decision (₹) this user may approve; null = cannot approve.
  approvalLimit   Decimal?  @db.Decimal(12, 2)
  // One-time link token for an invited user to set a password.
  inviteToken     String?   @unique
  inviteExpiresAt DateTime?
  sessions  Session[]
  createdAt DateTime @default(now())
}

// Web login session (bearer token). Expired or logged-out sessions are deleted.
model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model Lane {
  id          String   @id @default(cuid())
  shipperId   String
  shipper     Company  @relation("ShipperLanes", fields: [shipperId], references: [id])
  origin      String   // city
  destination String   // city
  truckType   String
  // Retired: the budget is now entered per booking (Trip.budget). Kept so older values are not lost;
  // the app no longer reads or writes it.
  budget      Decimal? @db.Decimal(12, 2)
  // ASK = every award needs approval; AUTO_LOWEST = lowest quote within the booking's budget is awarded (BRD §7).
  awardRule   String   @default("ASK")
  isActive    Boolean  @default(true)
  carriers    LaneCarrier[]
  trips       Trip[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([shipperId, origin, destination, truckType])
}

// A carrier's truck (carrier spec C5). Status is worked out from document dates and trips, never stored.
model Truck {
  id          String    @id @default(cuid())
  carrierId   String
  // Stored without spaces, e.g. TN09BX4471; shown as "TN 09 BX 4471".
  number      String    @unique
  truckType   String
  // OWN | ATTACHED (attached trucks belong to an outside owner who is paid per trip).
  ownership   String    @default("OWN")
  make        String?
  capacityKg  Decimal?  @db.Decimal(12, 2)
  ownerName   String?
  ownerPhone  String?
  rcExpiry    DateTime?
  insuranceExpiry DateTime?
  permitExpiry DateTime?
  fitnessExpiry DateTime?
  pucExpiry   DateTime?
  usualDriverId String?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @default(now()) @updatedAt

  @@index([carrierId])
}

// A carrier's driver (carrier spec C6). Drivers work on WhatsApp only; they have no login.
model Driver {
  id            String    @id @default(cuid())
  carrierId     String
  name          String
  phone         String    @unique
  licenceNumber String?
  // Vehicle class on the licence: LMV, HMV, HGMV or HTV. Phase 4 checks it against the truck type.
  licenceClass  String?
  licenceExpiry DateTime?
  language      String    @default("en")
  // Advances go only to a verified UPI ID. A change by one person waits for a second (maker-checker).
  upiId         String?
  upiVerifiedAt DateTime?
  pendingUpiId  String?
  pendingUpiById String?
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @default(now()) @updatedAt

  @@index([carrierId])
}

// A carrier's agreed rates for one shipper: one card per shipper and carrier, one line per
// city pair and truck type. A reference for bookings and quotes; never enforced on its own.
model RateCard {
  id        String         @id @default(cuid())
  shipperId String
  shipper   Company        @relation("ShipperRateCards", fields: [shipperId], references: [id])
  carrierId String
  carrier   Company        @relation("CarrierRateCards", fields: [carrierId], references: [id])
  validFrom DateTime?      @db.Date
  validTo   DateTime?      @db.Date
  notes     String?
  lines     RateCardLine[]
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@unique([shipperId, carrierId])
}

model RateCardLine {
  id              String   @id @default(cuid())
  rateCardId      String
  rateCard        RateCard @relation(fields: [rateCardId], references: [id], onDelete: Cascade)
  origin          String // city
  destination     String // city
  truckType       String
  // Freight per trip (₹).
  rate            Decimal  @db.Decimal(12, 2)
  // Charged per day the truck waits beyond the free time (₹), if agreed.
  detentionPerDay Decimal? @db.Decimal(12, 2)
  transitDays     Int?

  @@unique([rateCardId, origin, destination, truckType])
}

// A carrier's own price for a lane and truck type, for one shipper or any shipper (carrier spec C3).
// Separate from RateCard, which is the shipper's master-data record of rates agreed with a carrier.
model CarrierRate {
  id          String    @id @default(cuid())
  carrierId   String
  // Null = any shipper. A shipper-specific line wins over an "any shipper" line.
  shipperId   String?
  laneId      String?
  origin      String
  destination String
  truckType   String
  rate        Decimal   @db.Decimal(12, 2)
  // Quotes within ±bandPct of the rate go out without the owner.
  bandPct     Decimal   @db.Decimal(5, 2)
  // Estimated cost of running the trip; the margin floor is checked against it.
  tripCost    Decimal?  @db.Decimal(12, 2)
  validFrom   DateTime
  validTo     DateTime
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @default(now()) @updatedAt

  @@index([carrierId])
}

model LrSeries {
  id        String @id @default(cuid())
  carrierId String @unique
  prefix    String
  nextNumber Int   @default(1)
}

model Trip {
  id         String     @id @default(cuid())
  // Human trip number, e.g. TR-24101, from a database sequence (never reused).
  number     String     @unique @default(dbgenerated("'TR-' || nextval('trip_number_seq')"))
  shipperId  String
  shipper    Company    @relation("ShipperTrips", fields: [shipperId], references: [id])
  carrierId  String?
  carrier    Company?   @relation("CarrierTrips", fields: [carrierId], references: [id])
  laneId     String?
  lane       Lane?      @relation(fields: [laneId], references: [id])
  pickupAddressId String?
  pickupAddress   Address? @relation("TripPickup", fields: [pickupAddressId], references: [id])
  dropAddressId   String?
  dropAddress     Address? @relation("TripDrop", fields: [dropAddressId], references: [id])
  pickupDate DateTime?
  material   String?
  weightKg   Decimal?   @db.Decimal(12, 2)
  truckType  String?
  truckId    String?
  driverId   String?
  receiverContact String?
  reference  String?
  notes      String?
  // Freight budget for this trip (₹), entered at booking. Quotes above it are flagged; auto-award never exceeds it.
  budget     Decimal?   @db.Decimal(12, 2)
  status     TripStatus @default(REQUEST_RECEIVED)
  quoteDeadline DateTime?
  // Set when every carrier replied or the deadline passed; awards are made after this or earlier by choice.
  quotesClosedAt DateTime?
  awardedAmount Decimal? @db.Decimal(12, 2)
  awardedAt  DateTime?
  awardedById String?
  createdById String?
  // Execution (reported by the carrier / driver modules through integration points).
  truckNumber    String?
  driverName     String?
  driverPhone    String?
  // When the assigned truck is expected at pickup (optional, entered by the carrier at assignment).
  pickupEta      DateTime?
  eta            DateTime?
  // First ETA given at loading; "on time" means delivered by this (later delays move eta, not this).
  promisedEta    DateTime?
  lastLocation   String?
  lastUpdateAt   DateTime?
  deliveredAt    DateTime?
  goodQty        Int?
  damagedQty     Int?
  deliveryRemarks String?
  // POD (BRD §4.10). Accepted by rule when clean, or by a person when it shows a problem.
  podAcceptedAt  DateTime?
  podAcceptedById String?
  podHardCopyAt  DateTime?
  closedAt       DateTime?
  // Cancellation (BRD §5: from any status before Delivered, with a reason).
  cancelledAt    DateTime?
  cancelledById  String?
  cancelReason   String?
  quotes     Quote[]
  documents  Document[]
  approvals  Approval[]
  claims     Claim[]
  invoices   Invoice[]
  exceptions TripException[]
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  @@index([shipperId, status])
  @@index([shipperId, createdAt])
}

// One row per carrier asked to quote on a trip (BRD §4.2–4.4).
model Quote {
  id        String   @id @default(cuid())
  tripId    String
  trip      Trip     @relation(fields: [tripId], references: [id])
  carrierId String
  carrier   Company  @relation(fields: [carrierId], references: [id])
  // QUEUED → REQUESTED (offered) → AWARDED (accepted) | DECLINED | EXPIRED; remaining QUEUED/REQUESTED become
  // WITHDRAWN on award or cancel. Older rows may hold QUOTED / LOST.
  status    String   @default("REQUESTED")
  amount    Decimal? @db.Decimal(12, 2)
  score     Decimal? @db.Decimal(6, 2)
  isWinner  Boolean  @default(false)
  quotedAt  DateTime?
  // Contract-rate offers: order in the offer list (1 = lowest rate) and when the offer reached the carrier.
  sequence       Int?
  offeredAt      DateTime?
  respondBy      DateTime?
  rateCardLineId String?
  respondedById  String?
  declineReason  String?
  createdAt DateTime @default(now())

  @@unique([tripId, carrierId])
}

model Document {
  id        String   @id @default(cuid())
  tripId    String
  trip      Trip     @relation(fields: [tripId], references: [id])
  kind      String   // LR, EWAY_BILL, POD, INVOICE
  number    String?
  isVoid    Boolean  @default(false)
  fileUrl   String?
  validUntil DateTime?
  // Carrier LR lifecycle (phase 4): who issued it, and why and by whom it was voided; replacedById is the reissued LR.
  issuedById   String?
  voidReason   String?
  voidedById   String?
  voidedAt     DateTime?
  replacedById String?
  createdAt DateTime @default(now())
}

// Shortage or damage claim against the carrier, raised from the POD (BRD §4.10).
model Claim {
  id          String   @id @default(cuid())
  number      String   @unique @default(dbgenerated("'CL-' || nextval('claim_number_seq')"))
  tripId      String
  trip        Trip     @relation(fields: [tripId], references: [id])
  kind        String   // DAMAGE | SHORTAGE
  qty         Int
  unitValue   Decimal  @db.Decimal(12, 2)
  amount      Decimal  @db.Decimal(12, 2)
  description String
  // RAISED → ACCEPTED | DISPUTED; WITHDRAWN by the shipper.
  status      String   @default("RAISED")
  carrierNote String?
  raisedById  String
  respondedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Carrier's invoice to the shipper (BRD §4.11). One open invoice per trip; a queried one is replaced.
model Invoice {
  id             String   @id @default(cuid())
  number         String
  tripId         String
  trip           Trip     @relation(fields: [tripId], references: [id])
  carrierId      String
  freight        Decimal  @db.Decimal(12, 2)
  detention      Decimal  @default(0) @db.Decimal(12, 2)
  claimDeduction Decimal  @default(0) @db.Decimal(12, 2)
  total          Decimal  @db.Decimal(12, 2)
  dueDate        DateTime
  // RECEIVED → APPROVED → PAID; QUERIED (carrier must resend) | REPLACED.
  status         String   @default("RECEIVED")
  queryReason    String?
  approvedById   String?
  approvedAt     DateTime?
  paidAt         DateTime?
  paymentMode    String?  // UPI | BANK
  paymentRef     String?
  postedToErp    Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([tripId])
}

model Approval {
  id          String         @id @default(cuid())
  companyId   String?
  tripId      String?
  trip        Trip?          @relation(fields: [tripId], references: [id])
  kind        String         // AWARD, QUOTE, INVOICE, OVERRIDE, ...
  approverId  String?
  status      ApprovalStatus @default(PENDING)
  payload     Json
  reason      String?
  decidedAt   DateTime?
  createdAt   DateTime       @default(now())
}

model AuditLog {
  id        String   @id @default(cuid())
  tripId    String?
  actor     String   // agent name or user id
  action    String
  reason    String?
  data      Json?
  createdAt DateTime @default(now())
}

// A problem on the road (BRD §4.9): breakdown, accident or delay, with the fix the agent proposes.
model TripException {
  id          String   @id @default(cuid())
  tripId      String
  trip        Trip     @relation(fields: [tripId], references: [id])
  kind        String   // BREAKDOWN | ACCIDENT | DELAY | OTHER
  description String
  // Proposed fix: { fix: SWAP|WAIT|REPAIR|TRANSHIP, label, newEta, extraCost, payer: CARRIER|SHIPPER }
  proposal    Json?
  // OPEN (carrier handling) | AWAITING_SHIPPER (extra cost to the shipper) | APPROVED | REJECTED | RESOLVED
  status      String   @default("OPEN")
  decidedById String?
  decisionReason String?
  decidedAt   DateTime?
  resolvedAt  DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([tripId])
}

// In-app notification for a shipper user (bell in the header). One row per user.
model Notification {
  id        String    @id @default(cuid())
  companyId String
  userId    String?
  kind      String
  tripId    String?
  title     String
  body      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, readAt, createdAt])
  @@index([companyId, createdAt])
}

